# ╔═══════════════════════════════════════════╗
# ║    JAMAIKA CHECKER BOT — Environment      ║
# ╚═══════════════════════════════════════════╝
# انسخ هذا الملف إلى .env لو شغّلت محلياً
# على Vercel: أضف هذه المتغيرات من Settings → Environment Variables

# ── مطلوب ────────────────────────────────────────────────────────────────────
BOT_TOKEN=your_telegram_bot_token_here
ADMIN_ID=6409122908

# ── اختيارى ──────────────────────────────────────────────────────────────────
# DATA_DIR على Vercel يُعيَّن تلقائياً من vercel.json
DATA_DIR=/tmp

# عنوان النشر الدائم — يثبّت الـ Webhook على الـ alias بدل عنوان الـ deploy
# المتغيّر، ويمنع تكرار استدعاء setWebhook (و أخطاء 429) مع كل طلب.
APP_URL=https://your-app.vercel.app
